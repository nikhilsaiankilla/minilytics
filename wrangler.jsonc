{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "minilytics",
	"main": "src/worker/index.ts",
	"compatibility_date": "2025-09-01",
	"observability": {
		"enabled": true
	},
	"triggers": {
		"crons": ["*/5 * * * *"]
	},
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "none",
		// Static files skip the Worker. Anything else (client routes, unknown paths) runs it so missing pages return a real 404.
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "minilytics",
			// Replace with the id printed by `npx wrangler d1 create minilytics`.
			"database_id": "c47826f5-22d1-4161-8257-1b3ca225a2e5",
			"migrations_dir": "migrations"
		}
	]
}